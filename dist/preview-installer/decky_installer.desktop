#!/usr/bin/env xdg-open
[Desktop Entry]
Name=Install Decky — SteamOS 3.10 Preview Fix (Unofficial)
Comment=Install saboya's experimental Decky build, not the upstream release
Exec=sh -c "status=0; if d=\\$(mktemp -d); then if curl --fail --show-error --location --connect-timeout 60 https://github.com/saboya/decky-loader/releases/download/steamos-3.10-preview/user_install_script.sh --output \\"\\$d/user_install_script.sh\\"; then bash \\"\\$d/user_install_script.sh\\" || status=\\$?; else status=\\$?; echo 'Could not download the installer.' >&2; fi; rm -f \\"\\$d/user_install_script.sh\\"; rmdir \\"\\$d\\"; else status=\\$?; fi; if [ \\"\\$status\\" -ne 0 ]; then echo Installer failed with exit code \\"\\$status\\". Press Enter to close. >&2; read -r answer; fi; exit \\"\\$status\\""
Icon=steamdeck-gaming-return
Terminal=true
Type=Application
StartupNotify=false
